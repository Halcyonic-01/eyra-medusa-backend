# ─────────────────────────────────────────────────────────────────────────
# EYRA Medusa Backend — environment variables
#
# Local dev: copy this to .env and fill in real values (a working .env with
# localhost defaults already exists in this scaffold — this file is the
# reference for what to set on Railway).
#
# Railway: paste these into the backend service's Variables tab.
# ─────────────────────────────────────────────────────────────────────────

# Provided automatically if you add this service via Railway's "Reference
# Variable" to your Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Optional. Without it Medusa falls back to an in-memory event bus/workflow
# engine, which is fine for a single-instance deployment. Add a Railway
# Redis plugin service later if you outgrow this.
REDIS_URL=

# Generate with: openssl rand -hex 32 (use a DIFFERENT value for each)
JWT_SECRET=
COOKIE_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this backend. No trailing slashes.

# Your storefront(s) — the Next.js app calling /store/* endpoints.
STORE_CORS=https://eyra.org.in,https://www.eyra.org.in,https://eyra-pearl.vercel.app,http://localhost:3000

# Wherever you'll open the Medusa Admin dashboard — this backend's own
# Railway domain (fill in after first deploy) plus localhost for local dev.
ADMIN_CORS=https://<your-railway-domain>.up.railway.app,http://localhost:9000

# Union of the above — anything hitting /auth/*.
AUTH_CORS=https://eyra.org.in,https://www.eyra.org.in,https://eyra-pearl.vercel.app,https://<your-railway-domain>.up.railway.app,http://localhost:3000,http://localhost:9000

# ── Razorpay ─────────────────────────────────────────────────────────────
# Same test-mode values already sitting in the frontend's .env.local.
RAZORPAY_ID=
RAZORPAY_SECRET=
RAZORPAY_ACCOUNT=
RAZORPAY_WEBHOOK_SECRET=

# Set true only if you want to run this service purely as an API with the
# Admin dashboard disabled (e.g. a dedicated worker instance). Leave unset
# for a normal single-instance deployment.
# DISABLE_MEDUSA_ADMIN=true

# ── Order dispatch ───────────────────────────────────────────────────────
# Orders are shipped by a job here, not by the customer's browser. It asks the
# storefront (which talks to Shiprocket) to create the shipment, using the same
# URL and secret as product revalidation, so both must be set:
# STOREFRONT_REVALIDATE_URL=https://eyra.org.in/api/revalidate
# STOREFRONT_REVALIDATE_SECRET=

# Its own secret for creating shipments, since that spends Shiprocket wallet
# money. Set the same value on the storefront at the same time.
# Generate with: openssl rand -hex 32
# STOREFRONT_SHIPMENT_SECRET=

# Minutes an order is held before its shipment is created, which is also how
# long the customer can cancel. 0 (the default) creates the shipment at once.
# ORDER_CANCEL_WINDOW_MINUTES=0

# Kept from the refund (in rupees) when a customer cancels and asks for it back
# on their original payment method. Wallet refunds are always in full.
# ORDER_CANCEL_FEE=100

# How long customers are told a bank refund takes.
# BANK_REFUND_ETA=5 to 7 working days

# Set to false to turn the dispatcher off completely.
# ORDER_DISPATCH_ENABLED=true

# Start of each tax invoice number, for example EYRA/26-27/00001. Letters and
# digits only, up to 6 characters.
# INVOICE_PREFIX=EYRA

# ── Persistent file storage (S3) ─────────────────────────────────────────
# Product images uploaded in the Medusa admin and the invoice PDFs are saved
# here. Railway's disk is wiped on every deploy, so without these the images
# disappear. Set all three of the first block, or none (local disk, for local
# development only). Setting some but not all stops the backend from starting,
# and names what is missing.
#
# The bucket needs ACLs enabled (Object Ownership: "Bucket owner preferred")
# because Medusa marks product images public-read and invoices private. Do NOT
# make the whole bucket public: only the objects marked public-read are. See
# docs/launch-commerce.md for the exact bucket and IAM setup.
# S3_BUCKET=eyra-media
# S3_REGION=ap-south-1
# S3_FILE_URL=https://eyra-media.s3.ap-south-1.amazonaws.com
# Prefer an IAM user limited to this one bucket. Leave both out to use the
# platform's IAM role instead. Never put these in the storefront.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket.
# S3_PREFIX=eyra/
# Only for S3-compatible stores (Cloudflare R2, MinIO).
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# ── Invoices and shipments ───────────────────────────────────────────────
# The backend asks the storefront to draw invoice PDFs and create shipments,
# with STOREFRONT_SHIPMENT_SECRET (see above). The PDF is stored once, in S3,
# after the order ships. The seller's GSTIN and address are set on the
# STOREFRONT (SELLER_GSTIN and the other SELLER_* values), not here.

# Optional, backend only: lets the Shiprocket provider look up live courier
# rates. Customers are not charged these (prepaid ships free; Cash on Delivery
# has its own charge), so this only changes the internal rate estimate. A token
# pasted here expires after about ten days.
# SHIPROCKET_API_TOKEN=
# SHIPROCKET_PICKUP_PINCODE=

# ── Customer emails ──────────────────────────────────────────────────────
# Shipped, delivered, refund and offer emails are sent by the STOREFRONT through
# Resend; the Resend variables live there (see its README). This service only
# asks, using STOREFRONT_REVALIDATE_URL and STOREFRONT_REVALIDATE_SECRET above.
# Set to false to stop it asking for any of them. See docs/customer-emails.md.
# CUSTOMER_EMAILS_ENABLED=true
